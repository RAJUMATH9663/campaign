# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campaign_manager?schema=public"

# --- Redis (for BullMQ background jobs) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- Server ---
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV=development

# --- AI Providers (used server-side only, never exposed to frontend) ---
AI_PROVIDER="anthropic"        # "anthropic" | "openai"
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- SMS Provider (official APIs only, e.g. Twilio, MSG91, etc.) ---
SMS_PROVIDER="mock"            # "mock" | "twilio" | "msg91"
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_API_SECRET=
SMS_SENDER_ID=

# --- WhatsApp Provider (official WhatsApp Business Cloud API or a BSP) ---
WHATSAPP_PROVIDER="mock"       # "mock" | "meta_cloud_api" | "twilio"
WHATSAPP_PROVIDER_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Rate limiting ---
SEND_BATCH_SIZE=20
SEND_BATCH_INTERVAL_MS=1000
